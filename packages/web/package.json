{
  "name": "@feedback/web",
  "version": "0.2.0",
  "description": "框架无关的反馈组件（Custom Element + Shadow DOM）；唯一运行时依赖 html2canvas-pro 仅用于内置视口截图，ESM 下懒加载",
  "type": "module",
  "license": "MIT",
  "main": "./dist/feedback-web.umd.cjs",
  "module": "./dist/feedback-web.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/feedback-web.umd.cjs",
  "jsdelivr": "./dist/feedback-web.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/feedback-web.js",
      "require": "./dist/feedback-web.umd.cjs",
      "default": "./dist/feedback-web.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "html2canvas-pro": "2.4.2"
  }
}
