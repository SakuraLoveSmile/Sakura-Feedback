# 生产环境变量模板：复制为 deploy/.env.prod（同目录，已被 .gitignore 排除）后填写。
# 该文件同时被 docker compose 用于变量替换（${FEEDBACK_IMAGE}、${UPDATER_*} 等）和服务容器环境。
#
# 首次接入 updater 的完整顺序：
#   cp deploy/.env.prod.example deploy/.env.prod      # 本文件
#   # 填 FEEDBACK_MASTER_KEY / FEEDBACK_PUBLIC_URL / FEEDBACK_IMAGE / UPDATER_IMAGE / UPDATER_IMAGE_NAME
#   bash deploy/install-updater.sh --deploy-dir /opt/1panel/docker/compose/feedback
#   #   → 核对运行中的部署 → 备份现有 compose 与环境文件 → 生成 600 随机令牌 → 登记既有数据卷
#   cd /opt/1panel/docker/compose/feedback && docker compose up -d
# 之后升级只需登录后台 →「系统更新」（updater 会自己改 FEEDBACK_IMAGE / FEEDBACK_DATA_VOLUME 两行）。

# 1) 反馈服务镜像：用 Actions 输出里的 digest，形如
#    ghcr.io/sakuralovesmile/sakura-feedback@sha256:0123...abcd
#    不要写 latest；后台一键更新会把这一行替换成新版本的 digest 引用。
FEEDBACK_IMAGE=

# 2) 公网地址：必须是浏览器实际访问的 origin（含协议，不带结尾斜杠）。
#    它参与 Cookie 写操作的同源校验，填错会导致管理页保存时报 origin_mismatch。
FEEDBACK_PUBLIC_URL=https://feedback.example.com

# 3) 主密钥：生成方式 node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
#    必须长期保留：更换/丢失会导致已存的 AI 与 Kaneo 凭据无法解密。
FEEDBACK_MASTER_KEY=

# 4) 初始管理员：仅在首次建立用户时读取
FEEDBACK_ADMIN_USER=admin
FEEDBACK_ADMIN_PASSWORD=

# 5) 既有数据卷名（external 卷的真实名字，不是 compose 里的 key `feedback-data`）。
#    必须是当前正在用的那个卷：install-updater.sh 会从运行中容器读取后写回本行；
#    后台一键更新只复制这个卷并把它改写成新卷名，旧卷永远保留。
#    典型值 = compose 项目前缀 + 卷 key：feedback_feedback-data
#    查看方法：docker inspect -f '{{range .Mounts}}{{.Name}} {{.Destination}}{{"\n"}}{{end}}' <feedback容器>
FEEDBACK_DATA_VOLUME=feedback_feedback-data

# 6) updater 执行器镜像：同样用 digest，来自同一个 Release 清单的 services.updater.digest
#    （ghcr.io/sakuralovesmile/sakura-feedback-updater@sha256:0123...abcd）
UPDATER_IMAGE=

# 7) 受管镜像名（不含标签与 digest）：updater 用它推导版本清单地址、拼出要拉取的镜像引用。
#    与 FEEDBACK_IMAGE 的仓库名一致，去掉 @sha256:... 或 :tag。
UPDATER_IMAGE_NAME=ghcr.io/sakuralovesmile/sakura-feedback

# 8) 部署目录：宿主与容器内必须完全一致（updater 用同一绝对路径挂载并改写 compose.yml / .env.prod）。
UPDATER_DEPLOY_DIR=/opt/1panel/docker/compose/feedback

# 9) 更新控制目录（宿主绝对路径，feedback 以 :ro 挂载）：updater 在此写 paused / release / state，
#    feedback 读 paused 判断是否暂停写入、读 state/tasks/*.json 展示进度。
FEEDBACK_UPDATE_CONTROL_DIR=/opt/1panel/docker/compose/feedback/update-control

# 10) 共享令牌文件（宿主绝对路径，600 权限，由 install-updater.sh 生成）：
#     feedback 读取该文件并在请求头 x-updater-token 里发送；updater 读 update-control/updater-token 校验。
#     两个文件内容相同；轮换见 deploy/README.md「令牌生成与轮换」。
FEEDBACK_UPDATE_TOKEN_FILE=/opt/1panel/docker/compose/feedback/update-control/feedback-token

# 11) updater 内网地址（compose 服务名:端口，不发布到宿主）：
#     默认 http://updater:8790；只有同一 compose 网络内的 feedback 能访问。
FEEDBACK_UPDATER_URL=http://updater:8790

# 12) 反馈服务的宿主端口绑定：必须是回环地址（公网入口一律走 Nginx TLS 终止）。
#     install-updater.sh 会按运行中容器的实际绑定登记本行；非回环绑定会被脚本拒绝。
FEEDBACK_BIND=127.0.0.1:8787

# 13) 可选：受管 compose 项目名与服务名（默认 feedback / feedback，一般不用改）。
# UPDATER_COMPOSE_PROJECT=feedback
# UPDATER_SERVICE=feedback

# 云服务器拉取私有 GHCR 使用只读凭据（PAT，仅 read:packages）：
#   echo "$GHCR_READ_TOKEN" | docker login ghcr.io -u <用户名> --password-stdin
# 登录凭证由 docker 自身保存，不要写进本文件。
# 令牌文件（update-control/*-token）与备份目录都不进版本库，也不要手工复制进仓库。
